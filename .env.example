# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Every value is optional: anything left blank falls back to the local demo version.

# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Blank = a local database on this computer.
DATABASE_URL=

# Clerk: Dashboard > API keys. Blank = the pick-a-person demo sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend: API Keys. Blank = emails only appear on the in-app Inbox page.
RESEND_API_KEY=
EMAIL_FROM=

# Full address of the app, used for links in emails (e.g. https://pms-app.vercel.app).
APP_URL=
